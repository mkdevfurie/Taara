# TAARA App — configuration de compilation
# Utilisation : flutter build apk --release --dart-define-from-file=.env
# Copier ce fichier en .env et remplir les valeurs.

# Clé Google AI Studio (https://aistudio.google.com/apikey)
# Vide = mode hors-ligne uniquement (cache + base embarquée)
GEMINI_API_KEY=

# URL publique de l'API backend (HTTPS obligatoire en release)
TAARA_API_URL=https://api.taara.app/api/v1
